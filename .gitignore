# ===== 密钥与本地配置：绝不上传 =====
config.js
config.local.*
*.token
.env
.env.*
secrets/

# ===== 生成的对话快照（含聊天内容与内部信息） =====
chat.js
chat.*.js
snapshot/
logs/
*.log

# ===== 运行时数据 =====
data/
*.db
*.sqlite
*.sqlite3
state.json

# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ===== 依赖 =====
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# ===== 编译产物：绝不提交 =====
# Go 编译出来的可执行文件没有任何扩展名，必须按路径精确挡 ——
# 否则 .gitignore 抓不到它，14MB 二进制就进仓库了。
/server/tigertally
/tigertally
server/tigertally

# 其他平台的产物
*.exe
*.dll
*.dylib
*.o
*.a

# 构建目录
dist/
build/
out/
